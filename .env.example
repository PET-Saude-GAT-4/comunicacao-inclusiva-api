# ==============================================================================
# Servidor da Aplicação
# ==============================================================================
# Porta em que o servidor Express escuta requisições (padrão: 8080)
PORT=8080

# URL base pública da API (usada para compor URLs de download de arquivos e pictogramas)
API_BASE_URL=http://localhost:8080

# URL base da aplicação Frontend (Dashboard Web - usada nos links de convite e e-mails)
FRONTEND_BASE_URL=http://localhost:3000

# ==============================================================================
# Banco de Dados
# ==============================================================================
# String de conexão com o banco PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comunicacao_db?schema=public

# Porta exposta pelo container PostgreSQL no Docker
DB_PORT=5434

# ==============================================================================
# Autenticação e Segurança
# ==============================================================================
# Chave secreta de no mínimo 32 caracteres para assinatura e validação dos tokens JWT
JWT_SECRET=super_secret_key_that_is_at_least_32_characters_long

# Senha do usuário administrador inicial gerado pela seed do Prisma
ADMIN_PASSWORD=exemple

# Tamanho mínimo de caracteres exigido para senhas de usuários
MIN_PASSWORD_LENGTH=8

# ==============================================================================
# Armazenamento de Arquivos
# ==============================================================================
# Caminho do diretório local para persistência de uploads de arquivos e mídia
FILE_STORAGE_DIR="./uploads"

# ==============================================================================
# Serviço de E-mail (SMTP)
# ==============================================================================
# Host do servidor SMTP (em dev com Docker use "mailpit", em prod o host do seu provedor)
SMTP_HOST=mailpit

# Porta do servidor SMTP (1025 para Mailpit dev, 465 com SSL ou 587 com STARTTLS)
SMTP_PORT=1025

# Define se a conexão com o SMTP utiliza TLS/SSL (true ou false)
SMTP_SECURE=false

# Usuário de autenticação do servidor SMTP (opcional em dev)
SMTP_USER=

# Senha de autenticação do servidor SMTP (opcional em dev)
SMTP_PASS=

# Nome e endereço do remetente exibido nos e-mails enviados
SMTP_FROM=noreply@comunicacao-inclusiva.local

# ==============================================================================
# Convites e Ativação de Contas
# ==============================================================================
# Tempo de expiração dos links de convite em horas (168 horas = 7 dias)
INVITATION_EXPIRES_HOURS=168