// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum FileType {
  image
  video
  audio
  document
  archive
  other
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           Int          @id @default(autoincrement())
  uuid         String       @unique @default(uuid())
  email        String       @unique
  passwordHash String
  roleId       Int
  role         Role         @relation(fields: [roleId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  storedFiles  StoredFile[]
  boards       Board[]      @relation("BoardAuthor")
  phrases      Phrase[]     @relation("PhraseAuthor")
}

model StoredFile {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  location     String     @unique
  filename     String
  originalName String
  fileSize     BigInt?
  mimeType     String
  fileType     FileType
  purpose      String?
  isPrivate    Boolean    @default(true)
  userId       Int?
  user         User?      @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pictogram    Pictogram?
  signWriting  SignWriting?
}

model Pictogram {
  id                   Int              @id @default(autoincrement())
  uuid                 String           @unique @default(uuid())
  description          String
  storedFileId         Int              @unique
  storedFile           StoredFile       @relation(fields: [storedFileId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  representativeBoards Board[]           @relation("BoardRepresentative")
  terms                Term[]
}

model SignWriting {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  description  String
  storedFileId Int        @unique
  storedFile   StoredFile @relation(fields: [storedFileId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  terms        Term[]
}

model Term {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(uuid())
  description   String
  pictogramId   Int
  pictogram     Pictogram   @relation(fields: [pictogramId], references: [id])
  signWritingId Int
  signWriting   SignWriting @relation(fields: [signWritingId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  boardTerms    BoardTerm[]
  phraseTerms   PhraseTerm[]

  @@unique([pictogramId, signWritingId])
}

model Board {
  id               Int              @id @default(autoincrement())
  uuid             String           @unique @default(uuid())
  title            String
  authorId         Int?
  author           User?            @relation("BoardAuthor", fields: [authorId], references: [id])
  representativeId Int
  representative   Pictogram        @relation("BoardRepresentative", fields: [representativeId], references: [id])
  /// A BoardTerm.id, the head of the linked list.
  first            Int?
  // Composite on (id, first) so the head must be a term of this same board,
  // not just any BoardTerm. NoAction defers the check to the end of the
  // statement, which lets a board's cascade delete remove its own head.
  head             BoardTerm?       @relation("BoardHead", fields: [id, first], references: [boardId, id], onDelete: NoAction, onUpdate: NoAction)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  terms            BoardTerm[]      @relation("BoardTerms")
  triggerChains    InteractionChain[] @relation("TriggerChain")
  responseChains   InteractionChain[] @relation("ResponseChain")
}

model BoardTerm {
  id      Int    @id @default(autoincrement())
  uuid    String @unique @default(uuid())
  boardId Int
  board   Board  @relation("BoardTerms", fields: [boardId], references: [id], onDelete: Cascade)
  termId  Int
  term    Term   @relation(fields: [termId], references: [id])
  next    Int?
  // Composite on (boardId, next) for the same reason as Board.head: the next
  // node must belong to this board.
  nextTerm      BoardTerm?  @relation("BoardTermNext", fields: [boardId, next], references: [boardId, id], onDelete: NoAction, onUpdate: NoAction)
  // Back-relations Prisma requires; no code reads them. They are lists rather
  // than 1:1 because 1:1 would demand @@unique([boardId, next]), which addTerm
  // briefly violates when the new node and its predecessor share a next.
  previousTerms BoardTerm[] @relation("BoardTermNext")
  headOf        Board[]     @relation("BoardHead")

  @@unique([boardId, id])
  @@unique([boardId, termId])
  @@index([boardId])
}

model Profession {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  specialities Speciality[]
}

model Speciality {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  name         String
  professionId Int
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([name, professionId])
}

/// Exactly one of triggerBoardId and triggerPhraseId is set: an exclusive arc.
/// That rule and the per-trigger uniqueness are a CHECK and two partial unique
/// indexes Prisma cannot express, so they live only in
/// migrations/20260918120000_add_phrase_trigger_and_listed_in_library and this
/// model does not fully describe the table. The arc costs a column per trigger
/// kind.
model InteractionChain {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  triggerBoardId  Int?
  triggerBoard    Board?   @relation("TriggerChain", fields: [triggerBoardId], references: [id], onDelete: Cascade)
  triggerPhraseId Int?
  triggerPhrase   Phrase?  @relation("TriggerPhraseChain", fields: [triggerPhraseId], references: [id], onDelete: Cascade)
  responseBoardId Int
  responseBoard   Board    @relation("ResponseChain", fields: [responseBoardId], references: [id], onDelete: Cascade)
  rank            Int
  label           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([triggerBoardId, rank])
  @@index([triggerPhraseId, rank])
}

model Phrase {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(uuid())
  description String
  authorId    Int?
  author      User?             @relation("PhraseAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  // publishedAt decides whether the phrase reaches devices; this decides
  // whether it is browsable there. An unlisted phrase still syncs, so it can
  // carry board recommendations without cluttering the library.
  listedInLibrary Boolean       @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  terms         PhraseTerm[]
  triggerChains InteractionChain[] @relation("TriggerPhraseChain")
}

model PhraseTerm {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  phraseId Int
  phrase   Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade)
  termId   Int
  term     Term   @relation(fields: [termId], references: [id])
  order    Int

  @@unique([phraseId, order])
}
