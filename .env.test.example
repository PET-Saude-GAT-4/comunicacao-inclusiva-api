# Copy to .env.test. Loaded when NODE_ENV=test (Jest sets it), on top of .env.
# The integration suite truncates every table: the database name must end in
# "_test", and it is created and migrated by `yarn test:integration`.

# The dev Postgres from docker-compose, reached from the host on ${DB_PORT}.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/comunicacao_test?schema=public

API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
JWT_SECRET=integration-test-secret-that-is-at-least-32-characters
FILE_STORAGE_DIR=./storage/test-uploads
MIN_PASSWORD_LENGTH=8
INVITATION_EXPIRES_HOURS=168

# Never contacted: the test suites replace nodemailer with a capturing fake.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@test.local
